{
  "crons": [
    {
      "path": "/api/collect",
      "schedule": "30 0 * * *"
    }
  ],
  "functions": {
    "api/collect.js": {
      "maxDuration": 60
    },
    "api/watch.js": {
      "maxDuration": 60
    },
    "api/probe.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "regions": [
    "icn1"
  ]
}
